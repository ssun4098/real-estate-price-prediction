# 복사해서 .env 로 쓰세요 (Copy-Item .env.example .env). .env 는 절대 공유하지 마세요.

# --- MySQL: 전에 만든 컨테이너 (land-mysql) --------------------------------
# Docker로 켤 때: 컨테이너 이름으로 접속 (docker-compose.yml 맨 위 '처음 한 번' 명령 필요)
MYSQL_CONTAINER=land-mysql
# MYSQL_NETWORK=v6_mysql
# Docker 없이 python -m server 로 켤 때: PC 주소와 docker ps 의 PORTS 칸 왼쪽 번호
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 계정은 두 방식 공통
MYSQL_USER=root
MYSQL_PASSWORD=
# 이 앱의 테이블을 둘 데이터베이스. 없으면 먼저 만드세요 (README 8장).
MYSQL_DATABASE=v6

# --- 웹 ----------------------------------------------------------------------
# 접속 포트 (127.0.0.1 에서만 열림)
# PUBLIC_PORT=4175
# 추가로 허용할 접속 주소, 쉼표로 구분 (기본: 127.0.0.1:포트, localhost:포트)
# ALLOWED_HOSTS=
# /api/docs (Swagger 화면) 켜기. 기본은 꺼짐
# ENABLE_DOCS=0

# --- 학습 모델 (선택. 모델이 생기기 전까지 비워 둠) --------------------------
# data/models/ 폴더 안의 "모듈:클래스". data/models/README.md 참고
# MODEL_ENTRYPOINT=

# --- 공공 API 키 -------------------------------------------------------------
VWORLD_API_KEY=
DATA_GO_KR_API_KEY=
JUSO_API_KEY=

# 브이월드 키에 등록한 서비스 주소와 같아야 합니다.
VWORLD_DOMAIN=http://127.0.0.1:4175

# 브이월드 전용 키 (선택). 비우면 VWORLD_API_KEY 사용
VWORLD_GEOCODER_API_KEY=
VWORLD_SEARCH_API_KEY=

# 통계 연동 (선택). 저장된 예시·기본 분석에는 필요 없음
KOSIS_API_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
