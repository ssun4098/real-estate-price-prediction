# 복사해서 .env 로 쓰세요 (Copy-Item .env.example .env). .env 는 절대 공유하지 마세요.

# --- MySQL: 전에 만든 컨테이너 (land-mysql) --------------------------------
# Docker로 켤 때: 컨테이너 이름으로 접속 (docker-compose.yml 맨 위 '처음 한 번' 명령 필요)
MYSQL_CONTAINER=land-mysql
# MYSQL_NETWORK=v6_mysql
# Docker 없이 python -m server 로 켤 때: PC 주소와 docker ps 의 PORTS 칸 왼쪽 번호
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 계정은 두 방식 공통
MYSQL_USER=root
MYSQL_PASSWORD=
# 이 앱의 테이블을 둘 데이터베이스. 없으면 먼저 만드세요 (README 8장).
MYSQL_DATABASE=v6

# --- 토지 실거래 자료 출처 -------------------------------------------------------
# table: 직접 적재한 land_trade 테이블에서 읽음 (기본값, API 호출 없음)
# api:   공공데이터포털 API로 받아서 앱 캐시 테이블에 보관
# LAND_TRADE_SOURCE=table

# --- 청약홈 분양정보 출처 ----------------------------------------------------------
# table: 직접 적재한 applyhome_apt_notice / applyhome_apt_model 테이블에서 읽음 (기본값, API 호출 없음)
# api:   공공데이터포털(청약홈) API로 조회
# APPLYHOME_SOURCE=table

# --- 매일 공공데이터 적재 (서버 안에서 자동 실행) -----------------------------------
# 매일 정해진 시각에 토지 실거래(최근 N개월)와 청약홈 공고·주택형을 받아 DB 테이블을 갱신합니다.
# 상태 확인: http://127.0.0.1:4175/api/daily-load
# DAILY_LOAD=on
# DAILY_LOAD_TIME=03:00
# DAILY_LOAD_MONTHS=3

# --- 웹 ----------------------------------------------------------------------
# 접속 포트 (127.0.0.1 에서만 열림)
# PUBLIC_PORT=4175
# (서버에 올리는 순서: docs/04-run-and-operate.md '서버에 올리기'. 열어 둘 포트는 80(HTTP)·443(HTTPS))
# /api/docs (Swagger 화면) 켜기. 기본은 꺼짐
# ENABLE_DOCS=0

# --- 학습 모델 -----------------------------------------------------------------
# data/models/ 폴더 안의 "모듈:클래스". data/models/README.md 참고
# 선형회귀 모델: 모델 파일 data/models/linear/model.joblib (약 65KB, git 에 있음)
# 예전 CatBoost 모델로 돌아가려면 land_price_model:LandPricePredictor
#   (그때는 data/models/model.cbm(약 110MB, Git LFS)이 있어야 합니다.) 파일이 없으면 앱은 뜨고 모델만 꺼집니다.
MODEL_ENTRYPOINT=land_price_linear:LandPriceLinearPredictor

# --- 공공 API 키 -------------------------------------------------------------
VWORLD_API_KEY=
DATA_GO_KR_API_KEY=
JUSO_API_KEY=

# 브이월드 키에 등록한 서비스 주소와 같아야 합니다. 서버에서는 접속 주소 (예: http://203.0.113.10, 도메인이 있으면 https://도메인)
VWORLD_DOMAIN=http://127.0.0.1:4175

# 브이월드 전용 키 (선택). 비우면 VWORLD_API_KEY 사용
VWORLD_GEOCODER_API_KEY=
VWORLD_SEARCH_API_KEY=

# 통계 연동 (선택). 저장된 예시·기본 분석에는 필요 없음
KOSIS_API_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
